def start_ngrok(port):
    info("Launching localtunnel...")
    try:
        # Runs localtunnel on your active Django port
        process = subprocess.Popen(
            ["npx", "localtunnel", "--port", str(port)],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            shell=True
        )
        return process
    except Exception as e:
        error(f"Failed to start localtunnel: {e}")
        return None